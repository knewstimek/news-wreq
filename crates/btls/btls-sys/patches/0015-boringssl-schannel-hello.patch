+// Post-handshake authentication.
+//
+// https://www.rfc-editor.org/rfc/rfc8446#section-4.2.6
+//
+// The client only advertises the extension. Servers never send it back, so
+// the ServerHello and EncryptedExtensions parsers reject it.
+
+static bool ext_post_handshake_auth_add_clienthello(
+    const SSL_HANDSHAKE *hs, CBB *out, CBB *out_compressible,
+    ssl_client_hello_type_t type) {
+  if (!hs->config->post_handshake_auth || hs->max_version < TLS1_3_VERSION ||
+      SSL_is_quic(hs->ssl)) {
+    return true;
+  }
+
+  if (!CBB_add_u16(out, TLSEXT_TYPE_post_handshake_auth) ||
+      !CBB_add_u16(out, 0 /* length */)) {
+    return false;
+  }
+  return true;
+}
